<Page
    x:Class="Moyue.LinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moyue"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Pivot x:Name="Hub" Title="来源与线路">
            <Pivot.HeaderTemplate>
                <DataTemplate x:DataType="local:LineSource">
                    <TextBlock Text="{x:Bind Name}" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
            <Pivot.ItemTemplate>
                <DataTemplate x:DataType="local:LineSource">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,32">
                            <TextBlock Text="当前线路" Style="{StaticResource CaptionMutedStyle}" />
                            <TextBlock Text="{x:Bind Active, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,2,0,0" />
                            <TextBlock Text="{x:Bind SyncText, Mode=OneWay}" Style="{StaticResource CaptionMutedStyle}" Margin="0,6,0,0" />
                            <TextBlock Text="{x:Bind Message, Mode=OneWay}" Foreground="{x:Bind MessageBrush, Mode=OneWay}" Visibility="{x:Bind MessageVisibility, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />

                            <TextBlock Text="网站线路" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource CaptionMutedStyle}" Margin="0,0,0,4" Text="轻点选择要使用的线路。漫画、收藏和阅读进度不受影响。" />
                            <ItemsControl ItemsSource="{x:Bind Lines, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:LineItem">
                                        <RadioButton GroupName="{x:Bind Group}" IsChecked="{x:Bind Active}" Click="LineClick" MinHeight="48">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Host}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionMutedStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Header="添加网站线路" PlaceholderText="https://" Margin="0,12,0,0" InputScope="Url" TextChanged="ManualChanged" />
                            <Button Content="添加并使用" Margin="0,8,0,0" MinWidth="120" Click="AddLineClick" />

                            <TextBlock Text="发布页" Style="{StaticResource SectionTitleStyle}" />
                            <TextBox Header="发布页网址" Text="{x:Bind Publication}" InputScope="Url" TextChanged="PublicationChanged" />
                            <HyperlinkButton Style="{StaticResource TextLinkStyle}" Content="保存发布页" Click="SavePublicationClick" />
                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionMutedStyle}" />

                            <StackPanel Visibility="{x:Bind ImageVisibility, Mode=OneWay}">
                                <TextBlock Text="图片线路" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{x:Bind ImageText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>

                            <Border Style="{StaticResource NoticeBorderStyle}" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="同步失败或线路都不可用时，会保留最近可用的地址，已下载的章节仍可离线阅读。" />
                                    <HyperlinkButton Style="{StaticResource TextLinkStyle}" Content="查看已下载" Click="OfflineClick" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </Pivot.ItemTemplate>
        </Pivot>
        <ProgressBar x:Name="Busy" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="SyncCommand" Label="立即同步" Click="SyncClick">
                <AppBarButton.Icon><FontIcon Glyph="&#xE895;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
