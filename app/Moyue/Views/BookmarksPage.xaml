<Page
    x:Class="Moyue.BookmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moyue"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,12,12,4">
            <TextBlock x:Name="AppName" Text="墨阅" Style="{StaticResource AppNameStyle}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="书签" Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <ListView
            x:Name="List"
            Grid.Row="1"
            Padding="12,0,12,24"
            ItemsSource="{Binding Source={StaticResource Groups}}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="ItemClick"
            ItemContainerStyle="{StaticResource RowContainerStyle}">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,12,0,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:BookmarkItem">
                    <StackPanel Background="Transparent" MinHeight="52" Padding="0,6,0,6" Holding="ItemHolding" RightTapped="ItemRightTapped">
                        <TextBlock Text="{x:Bind ChapterTitle}" Style="{StaticResource SingleLineTextStyle}" />
                        <TextBlock Text="{x:Bind Line}" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            x:Name="Empty"
            Grid.Row="1"
            Margin="12,16,12,0"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Style="{StaticResource SecondaryTextStyle}"
            Text="还没有书签。阅读时点底部工具栏的“书签”即可把当前页加入书签。" />
    </Grid>

    <Page.BottomAppBar>
        <CommandBar ClosedDisplayMode="Minimal">
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="ClearCommand" Label="清空书签" Click="ClearClick" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
