<Page
    x:Class="Moyue.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moyue"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <CollectionViewSource x:Name="Groups" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,12,12,4">
            <TextBlock Text="墨阅" Style="{StaticResource AppNameStyle}" />
            <TextBlock Text="历史" Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <ListView
            x:Name="List"
            Grid.Row="1"
            Padding="12,0,12,0"
            ItemsSource="{Binding Source={StaticResource Groups}}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="ItemClick"
            SelectionChanged="SelectionChanged"
            ItemContainerStyle="{StaticResource RowContainerStyle}">
            <ListView.GroupStyle>
                <GroupStyle HidesIfEmpty="True">
                    <GroupStyle.HeaderContainerStyle>
                        <Style TargetType="ListViewHeaderItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,12,0,4" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </GroupStyle.HeaderContainerStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:HistoryItem">
                    <Grid Background="Transparent" Padding="0,8,0,8" Holding="ItemHolding" RightTapped="ItemRightTapped">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:CoverImage Width="56" VerticalAlignment="Top" Book="{x:Bind Book}" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource SingleLineTextStyle}" FontSize="17" />
                            <TextBlock Text="{x:Bind Line}" Style="{StaticResource CaptionMutedStyle}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionMutedStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock
            x:Name="Empty"
            Grid.Row="1"
            Margin="12,16,12,0"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Style="{StaticResource SecondaryTextStyle}"
            Text="还没有阅读记录。打开任意章节后，这里会保存读到的位置。" />
    </Grid>

    <Page.BottomAppBar>
        <CommandBar x:Name="Commands">
            <AppBarButton x:Name="SelectCommand" Label="选择" Click="SelectClick">
                <AppBarButton.Icon><FontIcon Glyph="&#xE762;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ClearCommand" Label="清空" Click="ClearClick">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="DeleteCommand" Label="删除" Visibility="Collapsed" IsEnabled="False" Click="DeleteClick">
                <AppBarButton.Icon><FontIcon Glyph="&#xE74D;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CancelCommand" Label="取消" Visibility="Collapsed" Click="CancelClick">
                <AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
