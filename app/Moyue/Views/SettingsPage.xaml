<Page
    x:Class="Moyue.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="SettingNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionMutedStyle}">
            <Setter Property="Margin" Value="0,-4,0,16" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,12,12,4">
            <TextBlock Text="墨阅" Style="{StaticResource AppNameStyle}" />
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,32">
                <TextBlock Text="设备与阅读" Style="{StaticResource SectionTitleStyle}" />
                <ToggleSwitch x:Name="OldDevice" Header="老设备优化" Toggled="SettingToggled" />
                <TextBlock Style="{StaticResource SettingNoteStyle}" Text="减少图片占用，内存紧张时自动减少预加载。" />
                <ToggleSwitch x:Name="ReadingPriority" Header="阅读优先" Toggled="SettingToggled" />
                <TextBlock Style="{StaticResource SettingNoteStyle}" Text="阅读时让下载任务让行，先加载正在看的页面。" />
                <ToggleSwitch x:Name="PagedDefault" Header="默认横向翻页" Toggled="SettingToggled" />
                <TextBlock Style="{StaticResource SettingNoteStyle}" Text="关闭时使用纵向滚动。阅读器内也可以随时切换。" />
                <ComboBox x:Name="Preload" Header="预加载" MinWidth="200" SelectionChanged="ChoiceChanged">
                    <x:String>不预加载</x:String>
                    <x:String>后一页</x:String>
                    <x:String>后两页</x:String>
                    <x:String>后三页</x:String>
                </ComboBox>
                <TextBlock Style="{StaticResource SettingNoteStyle}" Margin="0,4,0,16" Text="页数越多翻页越顺，占用的内存也越多。" />

                <TextBlock Text="下载" Style="{StaticResource SectionTitleStyle}" />
                <ComboBox x:Name="Concurrency" Header="同时下载图片" MinWidth="200" SelectionChanged="ChoiceChanged">
                    <x:String>1 张</x:String>
                    <x:String>2 张</x:String>
                    <x:String>3 张</x:String>
                    <x:String>4 张</x:String>
                    <x:String>6 张</x:String>
                    <x:String>8 张</x:String>
                    <x:String>12 张</x:String>
                    <x:String>16 张</x:String>
                    <x:String>24 张</x:String>
                    <x:String>32 张</x:String>
                </ComboBox>
                <TextBlock Style="{StaticResource SettingNoteStyle}" Margin="0,4,0,16" Text="默认 2 张，最多 32 张。超过 8 张会明显增加内存和网络占用，老设备建议 2 到 4 张。失败的图片会自动重试，已保存的页面不会重复下载。" />
                <ToggleSwitch x:Name="WifiOnly" Header="仅 Wi-Fi 下载" Toggled="SettingToggled" />
                <TextBlock Style="{StaticResource SettingNoteStyle}" Text="使用移动网络时暂停下载任务，连上 Wi-Fi 后继续。" />

                <TextBlock Text="网络" Style="{StaticResource SectionTitleStyle}" />
                <ToggleSwitch x:Name="AutoSync" Header="自动同步网址" Toggled="SettingToggled" />
                <TextBlock Style="{StaticResource SettingNoteStyle}" Text="定期从发布页获取可用网址。同步失败时保留原来的线路。" />
                <ToggleSwitch x:Name="Failover" Header="连接失败自动换线" Toggled="SettingToggled" />
                <TextBlock Style="{StaticResource SettingNoteStyle}" Text="在同一来源的备用网址之间切换。" />
                <Button Style="{StaticResource TiltButtonStyle}" Click="LinesClick">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="来源与线路" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock Text="发布页、当前线路和手动选择" Style="{StaticResource CaptionMutedStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>
                </Button>

                <Button Style="{StaticResource TiltButtonStyle}" Click="LogClick">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="运行日志" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBlock Text="排查获取失败：每条线路尝试、图片与解码细节" Style="{StaticResource CaptionMutedStyle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="1" Glyph="&#xE9D2;" FontSize="16" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    </Grid>
                </Button>

                <TextBlock Text="存储" Style="{StaticResource SectionTitleStyle}" />
                <Grid MinHeight="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="图片缓存" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="CacheSize" Text="正在计算…" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <HyperlinkButton x:Name="ClearCacheLink" Grid.Column="1" Style="{StaticResource TextLinkStyle}" Content="清理" Click="ClearCacheClick" />
                </Grid>
                <ComboBox x:Name="CacheLimit" Header="缓存上限" MinWidth="200" Margin="0,8,0,0" SelectionChanged="ChoiceChanged">
                    <x:String>64 MB</x:String>
                    <x:String>128 MB</x:String>
                    <x:String>256 MB</x:String>
                    <x:String>512 MB</x:String>
                </ComboBox>
                <Grid MinHeight="56" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="已下载章节" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock x:Name="DownloadedCount" Style="{StaticResource CaptionMutedStyle}" />
                    </StackPanel>
                    <HyperlinkButton Grid.Column="1" Style="{StaticResource TextLinkStyle}" Content="管理" Click="ManageDownloadsClick" />
                </Grid>
                <Border Style="{StaticResource NoticeBorderStyle}" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="清理缓存不会删除主动下载的章节、收藏、历史和阅读进度。" />
                </Border>

                <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="About" Style="{StaticResource CaptionMutedStyle}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
