<Page
    x:Class="Moyue.AdvancedSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,12,12,4">
            <TextBlock Text="墨阅" Style="{StaticResource AppNameStyle}" />
            <TextBlock Text="高级搜索" Style="{StaticResource PageTitleStyle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12,0,12,24">
                <Border Style="{StaticResource NoticeBorderStyle}">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="关键词会发送到各来源；作者、标签和状态只筛选已加载的结果。来源没有提供的信息不会被当作匹配。" />
                </Border>

                <TextBlock Text="来源" Style="{StaticResource SectionTitleStyle}" />
                <CheckBox x:Name="UseJm" Content="JM" />
                <CheckBox x:Name="UseBoylove" Content="香香腐宅" />
                <CheckBox x:Name="UseManwa" Content="漫蛙" />
                <TextBlock x:Name="SourceError" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed" Text="请至少选择一个来源。" />

                <TextBlock Text="关键词" Style="{StaticResource SectionTitleStyle}" />
                <TextBox x:Name="Keywords" Header="关键词（用空格分隔）" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <RadioButton x:Name="MatchAll" GroupName="Match" Content="全部匹配" MinWidth="120" />
                    <RadioButton x:Name="MatchAny" GroupName="Match" Content="任一匹配" />
                </StackPanel>
                <TextBlock Style="{StaticResource CaptionMutedStyle}" Text="任一匹配最多支持四个关键词，会分别查询后合并。" />
                <TextBox x:Name="Exclude" Header="排除词（作用于标题和标签）" Margin="0,16,0,0" />

                <TextBlock Text="筛选已加载的结果" Style="{StaticResource SectionTitleStyle}" />
                <TextBox x:Name="Author" Header="作者" />
                <TextBox x:Name="Tags" Header="标签（全部匹配，用空格分隔；不填关键词时按标签搜索）" Margin="0,12,0,0" />
                <ComboBox x:Name="State" Header="连载状态" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <x:String>全部</x:String>
                    <x:String>连载</x:String>
                    <x:String>完结</x:String>
                </ComboBox>
                <ComboBox x:Name="Sort" Header="排序" Margin="0,12,0,0" HorizontalAlignment="Stretch">
                    <x:String>相关度</x:String>
                    <x:String>标题</x:String>
                </ComboBox>
                <TextBlock Style="{StaticResource CaptionMutedStyle}" Margin="0,6,0,0" Text="相关度只比较标题与关键词。各来源没有统一的热度或更新时间，因此不提供按热度排序。" />

                <TextBlock x:Name="ApplyError" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{StaticResource ErrorBrush}" Margin="0,24,0,0" Visibility="Collapsed" Text="请填写关键词或标签，至少一项。" />
                <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,12,0,0" Content="应用筛选并搜索" Click="ApplyClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Label="应用" Click="ApplyClick">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8FB;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="重置" Click="ResetClick">
                <AppBarButton.Icon><FontIcon Glyph="&#xE72C;" /></AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
